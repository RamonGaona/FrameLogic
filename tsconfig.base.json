{
    "compilerOptions": {
      "target": "ES2023",
      "module": "ESNext",
      "lib": [
        "ES2023",
        "DOM",
        "DOM.Iterable"
      ],
      "moduleResolution": "Bundler",
      "strict": true,
      "skipLibCheck": true,
      "verbatimModuleSyntax": true,
      "moduleDetection": "force",
      "noUnusedLocals": true,
      "noUnusedParameters": true,
      "noFallthroughCasesInSwitch": true
    }
  }